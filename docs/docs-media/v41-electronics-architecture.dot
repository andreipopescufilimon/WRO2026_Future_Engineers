digraph G {
graph [bgcolor="white",fontname="DejaVu Sans",ranksep="0.85",nodesep="0.50",pad="0.4",splines="ortho",dpi="160"];
node [shape="box",style="rounded,filled",fillcolor="#F2F6FB",color="#9CB2CB",penwidth="1.6",fontname="DejaVu Sans",fontsize="13",margin="0.20,0.15"];
edge [color="#58738F",penwidth="2.0",arrowsize="0.8",fontname="DejaVu Sans",fontsize="11"];

rankdir=TB;
subgraph cluster_p {label="POWER DISTRIBUTION";fontname="DejaVu Sans";color="#D5E3F0";bgcolor="#FAFCFE";
 battery [label="2S battery
300 mAh design pack",fillcolor="#FFF3D6"];
 drive [label="IFX9201SG H-bridge
D7 PWM / D8 DIR",fillcolor="#FFE8E2"];
 buck [label="5 V step-down
D24V50F5",fillcolor="#FFF3D6"];
 motor [label="50:1 rear-drive motor"];
 battery -> drive [label="battery-side rail"];
 battery -> buck [label="regulated rail input"];
 drive -> motor;
}
subgraph cluster_ctrl {label="CONTROL & SENSING";fontname="DejaVu Sans";color="#D5E3F0";
 nano [label="Arduino Nano ESP32
mode D11/D12, start D10",fillcolor="#DDECFB"];
 gyro [label="BMI088 custom IMU
primary I2C"];
 tof [label="4 × VL53L5CX
primary I2C
LPn A3/A2/A1/A0"];
 tcs [label="TCS34725 floor color
secondary I2C A6/A7"];
 cam [label="OpenMV N6
UART 19200 baud",fillcolor="#DFF5E8"];
 servo [label="MG90S servo
parallel steering D2"];
 encoder [label="Wheel encoder
A D5 / B D4"];
}
buck -> nano [label="5 V"];
buck -> servo [label="5 V"];
buck -> cam [label="supply: verify connector"];
nano -> servo [label="command"];
cam -> nano [label="S..., RED, GREEN"];
gyro -> nano [label="yaw rate"];
tof -> nano [label="4 × 4 range matrices"];
tcs -> nano [label="markers"];
encoder -> nano [label="ticks"];
nano -> drive [label="PWM / direction"];
}
