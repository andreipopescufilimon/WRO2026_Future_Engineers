digraph G {
graph [bgcolor="white",fontname="DejaVu Sans",ranksep="0.85",nodesep="0.50",pad="0.4",splines="ortho",dpi="160"];
node [shape="box",style="rounded,filled",fillcolor="#F2F6FB",color="#9CB2CB",penwidth="1.6",fontname="DejaVu Sans",fontsize="13",margin="0.20,0.15"];
edge [color="#58738F",penwidth="2.0",arrowsize="0.8",fontname="DejaVu Sans",fontsize="11"];

rankdir=LR;
obs [label="Observe
reproducible problem",fillcolor="#FFE8E2"];
hyp [label="Form hypothesis
mechanics / sensing / control"];
change [label="Change one
main variable",fillcolor="#FFF3D6"];
test [label="Repeat the same test
with raw measurements",fillcolor="#DFF5E8"];
judge [label="Improvement supported?",shape=diamond,fillcolor="#FFF3D6"];
keep [label="Keep change
commit + test evidence",fillcolor="#DDECFB"];
revert [label="Revert or refine
record failure",fillcolor="#FFE8E2"];
obs->hyp->change->test->judge;
judge->keep [label="yes"];
judge->revert [label="no"];
revert->hyp [constraint=false];
}
